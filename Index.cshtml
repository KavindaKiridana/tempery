@model MilkApp.Controllers.ViewCollectionsController.ViewCollectionsViewModel

<!-- Bootstrap CSS (if not already included) -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">

<!-- View Collections -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<!-- Alert for validation messages -->
<div id="alertContainer" style="display: none;">
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <span id="alertMessage"></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
</div>

<!-- Loading indicator -->
<div id="loadingIndicator" style="display: none;" class="text-center p-3">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <p class="mt-2">Loading collections...</p>
</div>

<p class="mb-1" style="color: purple; font-weight: bold;">Filter Records</p>

<div id="form">
    <div class="row mb-2">
        <div class="col-md-12">
            <!-- Filter Radio Buttons -->
            <div class="d-flex flex-wrap gap-2 mb-2" id="radioDiv">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="filter" id="center">
                    <label class="form-check-label" for="center">Center</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="filter" id="society">
                    <label class="form-check-label" for="society">Society</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="filter" id="collector">
                    <label class="form-check-label" for="collector">Collector</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="filter" id="directfarmer">
                    <label class="form-check-label" for="directfarmer">Direct Farmer</label>
                </div>
            </div>

            <!-- Filter Options -->
            <div class="row g-2 align-items-end">
                <!-- Center Selection (Hidden by default since it's not needed) -->
                <div class="col-md-3" id="centerOptionDiv" style="display: none;">
                    <label class="form-label">Center</label>
                    <select class="form-select" id="centerSelection">
                        <option disabled selected>-- Select Center --</option>
                        @foreach (var center in Model.Centers)
                        {
                            <option value="@center.Id">@center.CenterName</option>
                        }
                    </select>
                </div>

                <!-- Society Selection -->
                <div class="col-md-3" id="societyOptionDiv" style="display: none;">
                    <label class="form-label">Society</label>
                    <select class="form-select" id="societySelection">
                        <option disabled selected>-- Select Society --</option>
                        @foreach (var society in Model.Societies)
                        {
                            <option value="@society.SocietyCode">@society.SocietyName (@society.SocietyCode)</option>
                        }
                    </select>
                </div>

                <!-- Collector Selection -->
                <div class="col-md-3" id="collectorOptionDiv" style="display: none;">
                    <label class="form-label">Collector</label>
                    <select class="form-select" id="collectorSelection">
                        <option disabled selected>-- Select Collector --</option>
                        @foreach (var collector in Model.Collectors)
                        {
                            <option value="@collector.CollectorCode">@collector.CollectorName (@collector.CollectorCode)</option>
                        }
                    </select>
                </div>

                <!-- Date Range -->
                <div class="col-md-2">
                    <label class="form-label">From Date</label>
                    <input type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" id="fromDate">
                </div>
                <div class="col-md-2">
                    <label class="form-label">To Date</label>
                    <input type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" id="toDate">
                </div>

                <!-- View Button -->
                <div class="col-md-2">
                    <button class="btn btn-primary" type="button" id="btnView">
                        <i class="bi bi-search"></i> View Records
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Section -->
    <div id="resultsSection" style="display: none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Collection Records</h5>
            <div id="recordsInfo" class="text-muted small"></div>
        </div>

        <!-- Table Container with horizontal scroll for mobile -->
        <div class="table-responsive">
            <table class="table table-striped table-hover" id="collectionsTable">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Farmer Code</th>
                        <th>Parent</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>SNF</th>
                        <th>FAT</th>
                        <th>Quantity</th>
                        <th>Sync Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="collectionsTableBody">
                    <!-- Data will be populated here via JavaScript -->
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <nav aria-label="Collections pagination" id="paginationNav">
            <ul class="pagination justify-content-center" id="paginationList">
                <!-- Pagination buttons will be generated here -->
            </ul>
        </nav>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-end gap-2 mt-3">
        <button type="button" class="btn btn-success" id="btnSave" style="display: none;">
            <i class="bi bi-save"></i> Save
        </button>
        <button class="btn btn-secondary" id="btnCancel">
            <i class="bi bi-x-circle"></i> Clear
        </button>
    </div>
</div>

<!-- Custom CSS -->
<style>
    .table th {
        background-color: #495057;
        color: white;
        font-weight: 600;
        border: none;
    }

    .table td {
        vertical-align: middle;
        border-top: 1px solid #dee2e6;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    .pagination .page-link {
        color: #495057;
        border: 1px solid #dee2e6;
    }

    .pagination .page-item.active .page-link {
        background-color: purple;
        border-color: purple;
        color: white;
    }

    .pagination .page-link:hover {
        background-color: #e9ecef;
        border-color: #adb5bd;
    }

    .spinner-border {
        width: 2rem;
        height: 2rem;
    }

    .form-check-input:checked {
        background-color: purple;
        border-color: purple;
    }

    .btn-primary {
        background-color: purple;
        border-color: purple;
    }

        .btn-primary:hover {
            background-color: #663399;
            border-color: #663399;
        }
</style>

<!-- Include existing JavaScript files -->
<script src="~/Scripts/optionDiv.js"></script>

<!-- New JavaScript for View functionality -->
<script>
    // Global variables
    let currentPage = 1;
    let currentFilter = null;

    // Document ready
    document.addEventListener('DOMContentLoaded', function() {
        setupEventListeners();
        setupRadioSelectionControl(); // From optionDiv.js
    });

    function setupEventListeners() {
        // View button click
        document.getElementById('btnView').addEventListener('click', handleViewClick);

        // Cancel/Clear button click
        document.getElementById('btnCancel').addEventListener('click', handleClearClick);

        // Date validation
        document.getElementById('fromDate').addEventListener('change', validateDates);
        document.getElementById('toDate').addEventListener('change', validateDates);
    }

    function handleViewClick() {
        // Get selected filter type
        const selectedFilter = document.querySelector('input[name="filter"]:checked');
        if (!selectedFilter) {
            showAlert('Please select a filter type (Center, Society, Collector, or Direct Farmer).');
            return;
        }

        const filterType = selectedFilter.id;
        let filterValue = '';

        // Validate filter selections
        if (filterType === 'society') {
            const societySelect = document.getElementById('societySelection');
            if (societySelect.selectedIndex === 0) {
                showAlert('Please select a society.');
                return;
            }
            filterValue = societySelect.value;
        } else if (filterType === 'collector') {
            const collectorSelect = document.getElementById('collectorSelection');
            if (collectorSelect.selectedIndex === 0) {
                showAlert('Please select a collector.');
                return;
            }
            filterValue = collectorSelect.value;
        }

        // Get date values
        const fromDate = document.getElementById('fromDate').value;
        const toDate = document.getElementById('toDate').value;

        // Validate dates
        if (new Date(fromDate) > new Date(toDate)) {
            showAlert('From date cannot be greater than To date.');
            return;
        }

        // Store current filter for pagination
        currentFilter = {
            filterType: filterType,
            filterValue: filterValue,
            fromDate: fromDate,
            toDate: toDate
        };

        // Load data
        loadCollections(1);
    }

    function loadCollections(page) {
        if (!currentFilter) return;

        currentPage = page;

        // Show loading indicator
        document.getElementById('loadingIndicator').style.display = 'block';
        document.getElementById('resultsSection').style.display = 'none';
        hideAlert();

        // Prepare request data
        const requestData = {
            filterType: currentFilter.filterType,
            filterValue: currentFilter.filterValue,
            fromDate: currentFilter.fromDate,
            toDate: currentFilter.toDate,
            page: page
        };

        // Make AJAX request
        fetch('/ViewCollections/GetCollections', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify(requestData)
        })
        .then(response => response.json())
        .then(data => {
            document.getElementById('loadingIndicator').style.display = 'none';

            if (data.success) {
                displayCollections(data.data, data.currentPage, data.totalPages, data.totalRecords);
            } else {
                showAlert(data.message || 'An error occurred while loading data.');
            }
        })
        .catch(error => {
            document.getElementById('loadingIndicator').style.display = 'none';
            console.error('Error:', error);
            showAlert('An error occurred while loading data. Please try again.');
        });
    }

    function displayCollections(collections, currentPage, totalPages, totalRecords) {
        const tbody = document.getElementById('collectionsTableBody');
        const recordsInfo = document.getElementById('recordsInfo');
        const resultsSection = document.getElementById('resultsSection');

        // Clear existing data
        tbody.innerHTML = '';

        if (collections.length === 0) {
            tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted">No records found for the selected criteria.</td></tr>';
            recordsInfo.textContent = 'No records found';
        } else {
            // Populate table
            collections.forEach(collection => {
                const row = tbody.insertRow();
                row.innerHTML = `
                    <td>${collection.id}</td>
                    <td>${collection.farmerCode || '-'}</td>
                    <td>${collection.parent || '-'}</td>
                    <td>${collection.dateOf || '-'}</td>
                    <td>${collection.timeOf || '-'}</td>
                    <td>${collection.snf ? collection.snf.toFixed(1) : '0.0'}</td>
                    <td>${collection.fat ? collection.fat.toFixed(1) : '0.0'}</td>
                    <td>${collection.quantity ? collection.quantity.toFixed(3) : '0.000'}</td>
                    <td>${collection.syncCreated ? new Date(collection.syncCreated).toLocaleDateString() : '-'}</td>
                    <td>
                        <span class="badge ${collection.accept === 1 ? 'bg-success' : 'bg-warning'}">
                            ${collection.accept === 1 ? 'Accepted' : 'Pending'}
                        </span>
                    </td>
                `;
            });

            // Update records info
            const startRecord = ((currentPage - 1) * 50) + 1;
            const endRecord = Math.min(currentPage * 50, totalRecords);
            recordsInfo.textContent = `Showing ${startRecord}-${endRecord} of ${totalRecords} records`;
        }

        // Generate pagination
        generatePagination(currentPage, totalPages);

        // Show results
        resultsSection.style.display = 'block';
    }

    function generatePagination(currentPage, totalPages) {
        const paginationList = document.getElementById('paginationList');
        paginationList.innerHTML = '';

        if (totalPages <= 1) return;

        // Previous button
        const prevLi = document.createElement('li');
        prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
        prevLi.innerHTML = `<a class="page-link" href="#" data-page="${currentPage - 1}">Previous</a>`;
        paginationList.appendChild(prevLi);

        // Page numbers
        const startPage = Math.max(1, currentPage - 2);
        const endPage = Math.min(totalPages, currentPage + 2);

        // First page
        if (startPage > 1) {
            const firstLi = document.createElement('li');
            firstLi.className = 'page-item';
            firstLi.innerHTML = '<a class="page-link" href="#" data-page="1">1</a>';
            paginationList.appendChild(firstLi);

            if (startPage > 2) {
                const dotsLi = document.createElement('li');
                dotsLi.className = 'page-item disabled';
                dotsLi.innerHTML = '<span class="page-link">...</span>';
                paginationList.appendChild(dotsLi);
            }
        }

        // Page numbers around current page
        for (let i = startPage; i <= endPage; i++) {
            const pageLi = document.createElement('li');
            pageLi.className = `page-item ${i === currentPage ? 'active' : ''}`;
            pageLi.innerHTML = `<a class="page-link" href="#" data-page="${i}">${i}</a>`;
            paginationList.appendChild(pageLi);
        }

        // Last page
        if (endPage < totalPages) {
            if (endPage < totalPages - 1) {
                const dotsLi = document.createElement('li');
                dotsLi.className = 'page-item disabled';
                dotsLi.innerHTML = '<span class="page-link">...</span>';
                paginationList.appendChild(dotsLi);
            }

            const lastLi = document.createElement('li');
            lastLi.className = 'page-item';
            lastLi.innerHTML = `<a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a>';
            paginationList.appendChild(lastLi);
        }

        // Next button
        const nextLi = document.createElement('li');
        nextLi.className = `page-item ${currentPage === totalPages ? 'disabled' : ''}`;
        nextLi.innerHTML = `<a class="page-link" href="#" data-page="${currentPage + 1}">Next</a>`;
        paginationList.appendChild(nextLi);

        // Add click event listeners to pagination links
        paginationList.addEventListener('click', function(e) {
            e.preventDefault();
            if (e.target.tagName === 'A' && !e.target.parentElement.classList.contains('disabled')) {
                const page = parseInt(e.target.getAttribute('data-page'));
                loadCollections(page);
            }
        });
    }

    function handleClearClick() {
        // Clear all selections
        document.querySelectorAll('input[name="filter"]').forEach(radio => {
            radio.checked = false;
        });

        // Hide all option divs
        document.getElementById('centerOptionDiv').style.display = 'none';
        document.getElementById('societyOptionDiv').style.display = 'none';
        document.getElementById('collectorOptionDiv').style.display = 'none';

        // Reset select elements
        document.getElementById('centerSelection').selectedIndex = 0;
        document.getElementById('societySelection').selectedIndex = 0;
        document.getElementById('collectorSelection').selectedIndex = 0;

        // Reset dates to today
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('fromDate').value = today;
        document.getElementById('toDate').value = today;

        // Hide results
        document.getElementById('resultsSection').style.display = 'none';
        document.getElementById('loadingIndicator').style.display = 'none';
        hideAlert();

        // Clear current filter
        currentFilter = null;
        currentPage = 1;
    }

    function validateDates() {
        const fromDate = new Date(document.getElementById('fromDate').value);
        const toDate = new Date(document.getElementById('toDate').value);

        if (fromDate > toDate) {
            showAlert('From date cannot be greater than To date.');
        } else {
            hideAlert();
        }
    }

    function showAlert(message) {
        const alertContainer = document.getElementById('alertContainer');
        const alertMessage = document.getElementById('alertMessage');

        alertMessage.textContent = message;
        alertContainer.style.display = 'block';

        // Auto-hide after 5 seconds
        setTimeout(() => {
            hideAlert();
        }, 5000);
    }

    function hideAlert() {
        document.getElementById('alertContainer').style.display = 'none';
    }
</script>

<!-- Bootstrap JS (if not already included) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>