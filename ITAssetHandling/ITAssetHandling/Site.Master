<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="ITAssetHandling.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - My ASP.NET Application</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- Global 80% zoom styling -->
    <style type="text/css">
        body {
            zoom: 0.8;
        }
    </style>

</head>
<body>
    <form runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true">
        </asp:ScriptManager>

        <!-- Navigation bar - only visible to logged-in users -->
        <% if (Session["UserId"] != null && !string.IsNullOrEmpty(Session["UserId"].ToString()))
            { %>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" runat="server" href="~/About">ITAsset</a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/About">Request Form</a></li>
                        <% 
                            string[] allowedRoles = { "Editor", "IT Manager" };
                            if (Session["IsAuthorizer"] != null && allowedRoles.Contains(Session["IsAuthorizer"].ToString()))
                            { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Manage
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" runat="server" href="~/ManageCompany.aspx">Manage Company</a></li>
                                <li><a class="dropdown-item" runat="server" href="~/ManageDepartment.aspx">Manage Department</a></li>
                                <li><a class="dropdown-item" runat="server" href="~/ManageReason.aspx">Manage Reasons</a></li>
                                <li><a class="dropdown-item" runat="server" href="~/ManageSupplier.aspx">Manage Supplier</a></li>
                                <li><a class="dropdown-item" runat="server" href="~/ManageUser.aspx">Manage User</a></li>
                                <li><a class="dropdown-item" runat="server" href="~/ManageTemplate.aspx">Manage Template</a></li>
                            </ul>
                        </li>
                        <% } %>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" runat="server" href="Logout.aspx">Logout</a></li>
                    </ul>
                </div>
            </div>
        </nav>
        <% } %>

        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>

            <!--<hr />
              <footer>
                <p>&copy; <%: DateTime.Now.Year %> - My ASP.NET Application</p>
            </footer>-->
        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
